{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "related": false },
  "mutate": [
    "src/Wizard/**/*.ts?(x)",
    "!src/Wizard/**/*.test.tsx",
    "!src/Wizard/types.ts",
    "!src/Wizard/index.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "tsconfigFile": "",
  "tempDirName": "node_modules/.stryker-tmp"
}
