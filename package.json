{
  "name": "react-onboarding",
  "version": "2.0.0",
  "description": "Product tours for React: spotlight, animated steps, keyboard and screen reader support. 2.4 KB.",
  "keywords": [
    "react",
    "onboarding",
    "product-tour",
    "tour",
    "walkthrough",
    "spotlight",
    "coachmark",
    "tooltip",
    "popover",
    "guide"
  ],
  "type": "module",
  "license": "MIT",
  "author": "pasyuk.com@gmail.com",
  "homepage": "https://ilyapasyuk.github.io/react-wizard-tour/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyapasyuk/react-wizard-tour.git"
  },
  "bugs": {
    "url": "https://github.com/ilyapasyuk/react-wizard-tour/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/Wizard/style.css dist/style.css && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "build:demo": "vite build --mode demo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
